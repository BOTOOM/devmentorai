# Backend port inside the container and on the host.
BACKEND_PORT=3847

# Local-only by default. 0.0.0.0 exposes an unauthenticated API that can spend your Copilot quota.
BACKEND_BIND_ADDRESS=127.0.0.1

# Optional fine-grained PAT with the "Copilot Requests" permission. Classic ghp_ PATs are not supported.
COPILOT_GITHUB_TOKEN=

# Persistent named volumes by default; replace either value with a host path if needed.
DEVMENTORAI_COPILOT_VOLUME=devmentorai-copilot
DEVMENTORAI_DATA_VOLUME=devmentorai-data

# Match host directory ownership when using bind mounts. Defaults match the image user.
HOST_UID=10001
HOST_GID=10001

# Optional proxy configuration.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,backend

# Optional ngrok tunnel profile.
NGROK_AUTHTOKEN=
