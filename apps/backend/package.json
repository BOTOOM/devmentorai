{
  "name": "devmentorai-server",
  "version": "1.10.1",
  "private": false,
  "type": "module",
  "description": "DevMentorAI backend server — AI-powered DevOps mentoring via GitHub Copilot. Run with: npx devmentorai-server",
  "license": "MIT",
  "main": "./dist/server.js",
  "bin": {
    "devmentorai-server": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "devmentorai",
    "copilot",
    "github-copilot",
    "devops",
    "ai",
    "cli",
    "mentoring"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BOTOOM/devmentorai.git",
    "directory": "apps/backend"
  },
  "homepage": "https://github.com/BOTOOM/devmentorai#readme",
  "bugs": {
    "url": "https://github.com/BOTOOM/devmentorai/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:cli": "node dist/cli.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "release": "semantic-release"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@github/copilot": "^1.0.88",
    "@github/copilot-sdk": "^1.0.14",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@devmentorai/shared": "workspace:*",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "drizzle-kit": "^0.31.11",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
